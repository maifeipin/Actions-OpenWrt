#!/bin/sh
# Sing-box & sb (sing-box-menu) 固件首次启动初始化脚本
mkdir -p /etc/sing-box/nodes
[ -f /usr/bin/sb ] && chmod +x /usr/bin/sb
[ -f /usr/bin/sb ] && ln -sf /usr/bin/sb /usr/bin/sing-box-menu

# 确保 sing-box 二进制与 sb 控制台脚本在 sysupgrade 保留配置中
for path in /usr/bin/sing-box /etc/sing-box/ /etc/init.d/sing-box /usr/bin/sb /usr/bin/sing-box-menu; do
  grep -qF "$path" /etc/sysupgrade.conf || echo "$path" >> /etc/sysupgrade.conf
done

exit 0

